
SPRING_PROFILES_ACTIVE=prod

# Server Configuration
SERVER_PORT=8081

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=playgorithm

# JWT Configuration (Generate a secure 256-bit key for production!)
# Use: openssl rand -hex 32
JWT_SECRET=<your-256-bit-secret-key>
JWT_EXPIRATION=86400000

# Admin Configuration (Use strong credentials in production!)
ADMIN_SIGNUP_SECRET=<your-admin-signup-secret>
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<strong-admin-password>

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gemini AI Configuration
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Frontend Configuration
# ==========================================

# API URL (Backend URL for Vite build)
VITE_API_BASE_URL=http://localhost:8081

# Algorithm Visualizer URL
VITE_VISUALIZER_BASE_URL=http://localhost:3001

# Node Environment
NODE_ENV=production

# Frontend Port
FRONTEND_PORT=3000
