# Root .gitignore - make the repository show only Frontend/, Backend/, and AlgorithmVisualizer-master/
# Ignore everything by default
/*

# But don't ignore this gitignore file
.gitignore

# Keep only the main project folders visible to git
!/Frontend/
!/Frontend/**
!/Backend/
!/Backend/**
!/AlgorithmVisualizer-master/
!/AlgorithmVisualizer-master/**

# Ignore editor and reference artifacts
.vscode/
/References/
/Reference_UI_Components_Library.txt

# Ignore other game folders
/tictactoe-main/
/gridgarden-master/
/MediChain/
/Missionaries-and-Cannibals-Game-master/

# Ignore documentation files in root
/*.md
/AlgorithmVisualizer-master/*.md

# AlgorithmVisualizer specific ignores
/AlgorithmVisualizer-master/node_modules/
/AlgorithmVisualizer-master/.next/
/AlgorithmVisualizer-master/build/
/AlgorithmVisualizer-master/out/
/AlgorithmVisualizer-master/package-lock.json
/AlgorithmVisualizer-master/.github/
/AlgorithmVisualizer-master/Assets/
/AlgorithmVisualizer-master/README.md
/AlgorithmVisualizer-master/LICENSE

# Ignore Postman collections (optional - uncomment if you don't want to push)
# *.postman_collection.json
# *.postman_environment.json

# Note: each sub-project (Frontend/ Backend/ AlgorithmVisualizer-master/) can manage their own ignores.