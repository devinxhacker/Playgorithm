# ==========================================
# Frontend Docker Ignore
# ==========================================

# Git
.git
.gitignore

# IDE
.idea
.vscode

# Dependencies (we install fresh in Docker)
node_modules/

# Build outputs (we build inside Docker)
dist/
dist-ssr/

# Environment files (secrets should not be in image)
.env
.env.*
*.env
!.env.example

# Documentation
*.md
!README.md

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Test files (optional)
# __tests__/
# *.test.js
# *.spec.js
